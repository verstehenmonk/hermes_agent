# Hermes Business OS — environment template.
# Copy to ~/.hermes/secrets/<file>.env (NOT into this repo).
# bootstrap.sh reads from ~/.hermes/secrets — never from business/.

# ---- LLM providers -----------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional cheaper providers for monitor-tier crons:
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# ---- Slack -------------------------------------------------------------
# From `hermes gateway setup` — Slack app credentials.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_HOME_CHANNEL=#cos

# ---- GitHub ------------------------------------------------------------
# Fine-grained PAT scoped to the production repo.
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=                  # HMAC secret for the pr-review webhook

# ---- Linear ------------------------------------------------------------
LINEAR_API_KEY=

# ---- Notion ------------------------------------------------------------
NOTION_API_KEY=secret_...
# Notion database IDs — fill in the IDs from the URL of each DB
NOTION_DB_COMPANY_KB=
NOTION_DB_PIPELINE=
NOTION_DB_CUSTOMERS=
NOTION_DB_VENDORS=
NOTION_DB_FEEDBACK=
NOTION_DB_CONTENT_PIPELINE=

# ---- Google Workspace --------------------------------------------------
# Use OAuth via `hermes setup` rather than raw tokens.
GOOGLE_OAUTH_CREDS=~/.hermes/secrets/google-oauth.json

# ---- Stripe (READ-ONLY restricted key) ---------------------------------
STRIPE_API_KEY=rk_live_...              # NEVER use a full sk_live key here
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Vercel ------------------------------------------------------------
VERCEL_TOKEN=
VERCEL_WEBHOOK_SECRET=

# ---- Fly.io ------------------------------------------------------------
FLY_API_TOKEN=

# ---- Email (himalaya) --------------------------------------------------
HIMALAYA_GMAIL_PASSWORD=                # app-specific password, not your account password
